{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tray Inspector",
  "version": "0.1.0",
  "identifier": "com.trayinspector.desktop",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "powershell -ExecutionPolicy Bypass -File ../scripts/build_worker.ps1"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tray Inspector",
        "width": 1440,
        "height": 940,
        "minWidth": 900,
        "minHeight": 600,
        "maximized": true,
        "backgroundColor": "#EEF0F3"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": {
      "../worker-dist/tray-worker/": "worker/",
      "../../models/tlens-mobilenet-bare/model.onnx": "models/tlens-mobilenet-bare/model.onnx",
      "../../models/tlens-mobilenet-bare/slot_model.json": "models/tlens-mobilenet-bare/slot_model.json",
      "../../models/tlens-mobilenet/model.onnx": "models/tlens-mobilenet/model.onnx",
      "../../models/tlens-mobilenet/slot_model.json": "models/tlens-mobilenet/slot_model.json"
    }
  }
}
